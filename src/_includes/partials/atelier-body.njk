<div class="page-head"><span class="mono grey">{{ t.aboutAtelier }}</span></div>

<section class="statement">
  <div class="content statement-row">
    <div>
      {% for para in pages.atelier.intro[lang] %}
      <p>{{ para | safe }}</p>
      {% endfor %}
    </div>
    <div class="flow">
      {% for step in pages.atelier.flow[lang] %}
      <span>{{ step }}</span>{% if not loop.last %}<span class="arrow">→</span>{% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<div class="content">
  <div class="principles">
    <span class="section-label">{{ t.principlesLabel }}</span>

    <div class="principles-grid">
      <div class="principles-col-a">
        {% for pr in pages.atelier.principles %}
        {% if loop.index0 % 2 == 0 %}
        <div class="principle">
          <span class="pnum">{{ pr.num }}</span>
          <div>
            <h3>{{ pr.title[lang] }}</h3>
            <p>{{ pr.body[lang] }}</p>
          </div>
        </div>
        {% endif %}
        {% endfor %}
      </div>

      <div class="principles-col-b">
        {% for pr in pages.atelier.principles %}
        {% if loop.index0 % 2 == 1 %}
        <div class="principle">
          <span class="pnum">{{ pr.num }}</span>
          <div>
            <h3>{{ pr.title[lang] }}</h3>
            <p>{{ pr.body[lang] }}</p>
          </div>
        </div>
        {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div class="facts mono md">
  {% for f in pages.atelier.facts %}
  <div class="fact"><span class="k">{{ f.k[lang] }}</span><span class="v">{{ f.v[lang] }}</span></div>
  {% endfor %}
</div>

<div class="content" style="padding:32px 0 56px; text-align:center;">
  <a href="{{ nav.founder }}" class="btn-accent">{{ t.aboutFounder }}</a>
</div>
