<header>
  <nav class="wrap">
    <a href="{{ nav.home }}" class="wordmark">ORDUM</a>
    <div class="navlinks">
        <a href="{{ nav.prace }}"{% if navActive == "prace" %} id="navPrace"{% endif %}>{{ t.prace }}</a>
        <a href="{{ nav.atelier }}"{% if navActive == "atelier" %} class="active"{% endif %}>{{ t.atelier }}</a>
        <a href="{{ nav.kontakt }}"{% if navActive == "kontakt" %} class="active"{% endif %}>{{ t.kontakt }}</a>
    </div>
    <div class="navmeta">
      <div class="navsocial">
        <a href="mailto:ahoj@ordum.sk" aria-label="Email" title="Email">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="1"/><path d="M2 6l10 7 10-7"/></svg>
        </a>
        <a href="https://instagram.com/ordum.studio" target="_blank" rel="noopener" aria-label="Instagram" title="Instagram">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
        </a>
      </div>
      <div class="navlang">
        <a href="{{ langUrls.sk }}" class="lang{% if lang == 'sk' %} active{% endif %}">SK</a>
        <a href="{{ langUrls.en }}" class="lang{% if lang == 'en' %} active{% endif %}">EN</a>
      </div>
    </div>
  </nav>
</header>
