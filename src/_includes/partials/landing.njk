<section class="landing">
  <div class="hero-wrap landing-hero-wrap">
    <div class="landing-grid">
      <span class="landing-letters half-a">ORD</span><span class="landing-letters half-b">UM</span>
      <span class="landing-rule rule-a" aria-hidden="true"></span><span class="landing-rule rule-b" aria-hidden="true"></span>
      <div class="landing-cap cap-a">
        <span class="cap-term">ORDO</span><span class="cap-gloss">{{ t.ordoGloss }}</span>
      </div>
      <div class="landing-cap cap-b">
        <span class="cap-term">STRATUM</span><span class="cap-gloss">{{ t.stratumGloss }}</span>
      </div>
    </div>
  </div>

  <span class="landing-est">est. 2026</span>

  <div class="hero-wrap landing-bottom">
    <p>{{ t.landingIntro }}</p>
    <a href="#prace" class="landing-arrow">
      <span>{{ t.projects }}</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 4v16M6 14l6 6 6-6"/></svg>
    </a>
  </div>
</section>
