<div class="page-head"><span class="mono grey">{{ t.kontakt }}</span></div>

<section class="contact-fill">
  <div class="content contact-big">
    <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    <a href="tel:{{ site.phone_href }}">{{ site.phone }}</a>
  </div>

  <div class="contact-instagram">
    <a href="{{ site.instagram_url }}" target="_blank" rel="noopener" class="btn-accent">{{ t.instagram }}</a>
  </div>

  <div class="content contact-address">
    {% for line in site.address %}
    <div>{{ line }}</div>
    {% endfor %}
  </div>
</section>
